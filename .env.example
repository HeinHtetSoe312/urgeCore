# Copy to .env and edit. NEVER commit .env. Use URL-safe characters in passwords.
APP_ENV=local
POSTGRES_PASSWORD=change-me-local-only
REDIS_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+asyncpg://urge:change-me-local-only@localhost:5432/urge
REDIS_URL=redis://:change-me-local-only@localhost:6379/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-value-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=30
SETTLEMENT_WINDOW_SECONDS=7200
ENABLE_DOCS=true
LOG_LEVEL=INFO